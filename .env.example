# Copy to .env and fill in. docker compose reads this file automatically.

HOST_PORT=5050

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
AIENERGY_USER=aienergy
AIENERGY_PASSWORD=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=energy_user
MYSQL_PASSWORD=
MYSQL_DATABASE=unified

# Telemetry tables are named {TABLE_PREFIX}_power_YYMMDD and {TABLE_PREFIX}_energy_YYMMDD
TABLE_PREFIX=site
